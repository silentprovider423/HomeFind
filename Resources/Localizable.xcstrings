    "Dafür gehen Koordinaten an Apple. Ohne: Standortnamen und Adressen vom Server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sends coordinates to Apple. Without it: place names and addresses from your server."
          }
        }
      }
    },
    "Das Gerät verschwindet aus der Liste und hört beim nächsten Abgleich auf zu senden. Bereits gesendete Standorte bleiben in deinem Server-Verlauf.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device disappears from the list and stops sending at its next sync. Locations already sent stay in your server history."
          }
        }
      }
    },
    "Das Gerät, von dem %@ den Standort teilt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device %@ shares their location from."
          }
        }
      }
    },
    "Das ist kein HomeFind-Code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a HomeFind code."
