            "state": "translated",
            "value": "%1$@ (%2$@) möchte deinem Standort folgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) wants to follow your location."
          }
        }
