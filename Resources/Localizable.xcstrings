    "%@ verwendet eventuell HomeFind nicht. Lade die Person über die Weboberfläche deines Servers ein – sobald sie beitritt, erscheint sie hier.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ may not be using HomeFind. Invite them via your server's web interface – once they join, they appear here."
          }
        }
