          "stringUnit": {
            "state": "translated",
            "value": "Evaluated on this iPhone using the location %@ shares with you."
          }
        }
      }
    },
    "Ausgewertet auf diesem iPhone über Region Monitoring – es wird nichts zusätzlich gesendet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evaluated on this iPhone using region monitoring – nothing extra is sent."
