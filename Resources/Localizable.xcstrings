    "In „Einstellungen“ aktivieren": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn On in Settings"
          }
        }
      }
    },
    "Installiere HomeFind auf dem anderen iPhone oder iPad, tippe bei der Anmeldung auf „QR-Code scannen“ und halte die Kamera auf diesen Code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install HomeFind on the other iPhone or iPad, tap “Scan QR Code” when signing in and point the camera at this code."
          }
        }
      }
    },
    "Jeder gesendete Punkt bleibt in deinem Konto (Dawarich speichert einen Verlauf). Nur du siehst ihn; löschen in der Weboberfläche.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every point sent stays in your account (Dawarich keeps a history). Only you see it; delete it in the web interface."
