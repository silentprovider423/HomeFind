    "Datenschutz": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        }
      }
    },
    "Dein Server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server"
          }
        }
      }
    },
    "Dein Server teilt deinen Standort mit allen Mitgliedern deiner Familie. Neue Personen lädst du über die Weboberfläche ein.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server shares your location with all members of your family. Invite new people via the web interface."
          }
        }
      }
    },
    "Dein Server teilt mit der ganzen Familie – danach sieht niemand in deiner Familie deinen Standort.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server shares with the whole family – afterwards nobody in your family sees your location."
          }
        }
      }
    },
    "Dein Standort wird nicht mehr geteilt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is no longer shared."
          }
        }
      }
    },
    "Dein eigener Server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own server"
          }
        }
      }
    },
    "Deine Familie sieht deinen Standort für die gewählte Dauer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your family sees your location for the chosen duration."
          }
        }
      }
    },
    "Deine Familie sieht deinen Standort.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your family can see your location."
          }
        }
      }
    },
    "Deine Familie sieht deinen Standort. %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your family can see your location. %@."
          }
        }
      }
    },
    "Deine Orte (Privat, Arbeit …) und Ankunft/Verlassen dort.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your places (Home, Work …) and arrivals/departures there."
          }
        }
      }
    },
    "Deine Standorte liegen auf deinem eigenen Server, nicht bei Apple oder einem anderen Anbieter.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your locations live on your own server, not with Apple or any other provider."
          }
        }
      }
    },
    "Den Schlüssel findest du in der Weboberfläche unter „Einstellungen“ → „API-Schlüssel“.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll find the key in the web interface under “Settings” → “API key”."
          }
        }
      }
    },
    "Der Code enthält deinen Zugangsschlüssel. Zeige ihn nur auf deinen eigenen Geräten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code contains your access key. Only show it to your own devices."
          }
