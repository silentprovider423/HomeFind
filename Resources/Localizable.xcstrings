    "Im Hintergrund senden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send in Background"
          }
        }
      }
    },
    "Im Vordergrund höchstens jede Minute oder ab 50 m Bewegung, im Hintergrund nur bei deutlichen Ortswechseln und Besuchen. Kein Push, kein Dritt-SDK, keine Analyse.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the foreground at most once a minute or after 50 m of movement, in the background only on significant location changes and visits. No push, no third-party SDK, no analytics."
          }
        }
      }
    },
    "Immer erlauben": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Always"
          }
        }
      }
    },
