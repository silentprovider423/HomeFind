{
  "sourceLanguage": "de",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HomeFind"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HomeFind"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Scannen des QR-Codes, mit dem du ein weiteres Gerät verbindest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To scan the QR code that connects another device of yours."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zu deinem Standortserver im Heimnetz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection to your location server on your home network."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit deine Familie deinen Standort auch sieht, wenn HomeFind geschlossen ist. HomeFind sendet sparsam nur bei deutlichen Ortswechseln an deinen eigenen Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So your family can see your location even when HomeFind is closed. HomeFind only sends to your own server on significant location changes, to save battery."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit du dich auf der Karte siehst und deinen Standort über deinen eigenen Server teilen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So you can see yourself on the map and share your location through your own server."
          }
        }
      }
    }
  },
  "version": "1.0"
}